{
  "name": "Studyspace Orbit",
  "short_name": "Studyspace",
  "description": "Classes, homework, exams, grades and focus time — one calm place for your whole school life.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d13",
  "theme_color": "#0b0d13",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  },
  "shortcuts": [
    { "name": "Diary", "url": "./index.html#/diary" },
    { "name": "Focus", "url": "./index.html#/focus" },
    { "name": "Tasks", "url": "./index.html#/tasks" },
    { "name": "Flashcards", "url": "./index.html#/cards" }
  ]
}
